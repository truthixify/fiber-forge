{
  "name": "@truthixify/fiber-forge",
  "version": "0.4.0-rc.1",
  "type": "module",
  "description": "One-click local Fiber networks with a visual channel GUI",
  "license": "MIT",
  "keywords": [
    "fiber",
    "ckb",
    "nervos",
    "payment-channels",
    "lightning",
    "devnet",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/truthixify/fiber-forge.git"
  },
  "homepage": "https://github.com/truthixify/fiber-forge#readme",
  "bugs": {
    "url": "https://github.com/truthixify/fiber-forge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "fiberForge": {
    "images": {
      "ckb": "nervos/ckb:v0.201.0",
      "fiber": "nervos/fiber:0.9.0-rc7"
    }
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:e2e": "node scripts/live-evidence.mjs all",
    "test:sdk": "node scripts/verify-sdk-contract.mjs && tsc --noEmit -p test/fixtures/sdk-consumer/tsconfig.json && node test/fixtures/sdk-consumer/runtime.mjs",
    "test:package": "node scripts/verify-packed-artifact.mjs",
    "example:local": "node scripts/run-integration-example.mjs",
    "example:failure": "node scripts/run-integration-example.mjs --fail-after-payment",
    "example:bundle": "tsx scripts/generate-example-bundle.mjs",
    "sandbox:start": "node scripts/sandbox.mjs start",
    "sandbox:stop": "node scripts/sandbox.mjs stop",
    "sandbox:reset": "node scripts/sandbox.mjs reset",
    "sandbox:status": "node scripts/sandbox.mjs status",
    "lint": "tsc --noEmit",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "prettier": "^3.3",
    "typescript": "^5.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ckb-ccc/core": "^1.16.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "commander": "^15.0.0",
    "dockerode": "^5.0.1",
    "log-update": "^8.0.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "bin": {
    "fiber-forge": "bin/fiber-forge.mjs"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "assets",
    "docs/sdk.md",
    "docs/export-bundles.md",
    "docs/recovery.md",
    "docs/scenarios.md",
    "docs/force-close.md",
    "docs/fault-injection.md",
    "docs/lifecycle-errors.md",
    "docs/verification.md",
    "docs/compatibility.md",
    "docs/github-action.md",
    "docs/integration.md",
    "docs/sandbox.md",
    "docs/schema",
    "docs/examples/export-v1",
    "examples/payments.yml",
    "examples/outage-recovery.yml",
    "examples/topology.yml",
    "docs/evidence"
  ]
}
